{
  "name": "automationexercise-playwright",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps chromium",
    "clean:vendor-comments": "node ./scripts/cleanVendorComments.js",
    "postinstall": "patch-package && npm run clean:vendor-comments"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "patch-package": "^8.0.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}
